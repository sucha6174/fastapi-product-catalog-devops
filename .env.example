# ==========================================
# FastAPI Product Catalog - Environment Configuration
# ==========================================

# Database Connection URL (PostgreSQL format)
# Format: postgresql://<username>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/product_catalog

# PostgreSQL Container Credentials (used by Docker Compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=product_catalog
POSTGRES_PORT=5432

# Application Settings
APP_NAME="Product Catalog API"
APP_ENV=development
PORT=8000
HOST=0.0.0.0

# AWS Deployment Configuration (used by CI/CD workflows and Terraform)
AWS_REGION=us-east-1
ECR_REPOSITORY_NAME=fastapi-product-catalog
ECS_CLUSTER_NAME=fastapi-product-catalog-prod-cluster
ECS_SERVICE_NAME=fastapi-product-catalog-prod-service
